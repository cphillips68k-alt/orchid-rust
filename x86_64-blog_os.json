{
  "llvm-target": "x86_64-unknown-none",
  "data-layout": "e-m:u-i64:64-f80:128-n8:16:32:64-S128",
  "arch": "x86_64",
  "os": "none",
  "vendor": "unknown",
  "linker-flavor": "ld.lld",
  "linker": "rust-lld",
  "executables": true,
  "relocation-model": "static",
  "disable-redzone": true,
  "features": "-mmx,-sse,-sse2,-sse3,-x87",
  "panic-strategy": "abort",
  "cpu": "x86-64",
  "max-atomic-width": 128
}
